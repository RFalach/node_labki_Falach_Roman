{
    "name": "cool_name",
    "version": "1.0.0",
    "type": "module",
    "devDependencies": {
        "eslint": "^10.2.0",
        "globals": "^17.4.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1"
    },
    "dependencies": {
        "ajv": "^8.18.0"
    },
    "scripts": {
        "start": "node --env-file=.env.example app.js",
        "dev": "nodemon --env-file=.env.example app.js",
        "predev": "npm run check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write '**/*.{js,json,md}'",
        "format:check": "prettier --check '**/*.{js,json,md}'",
        "check": "npm run lint && npm run format:check"
    }
}
