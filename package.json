{
    "name": "cool_name",
    "version": "1.0.0",
    "type": "module",
    "devDependencies": {
        "eslint": "^10.2.0",
        "globals": "^17.4.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.8.1"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/env": "^6.0.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/multipart": "^10.0.0",
        "@fastify/sensible": "^6.0.4",
        "@fastify/static": "^9.1.3",
        "ajv": "^8.18.0",
        "csv-parse": "^6.2.1",
        "csv-stringify": "^6.7.0",
        "fastify": "^5.8.4"
